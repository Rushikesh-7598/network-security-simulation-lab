# Illustrative alert-only rules for controlled lab traffic.
alert http any any -> any 80 (msg:"LAB TEST: HTTP request to /lab-alert"; flow:established,to_server; http.uri; content:"/lab-alert"; sid:1000001; rev:1;)
alert dns any any -> any 53 (msg:"LAB TEST: DNS query for lab-test.invalid"; dns.query; content:"lab-test.invalid"; nocase; sid:1000002; rev:1;)
